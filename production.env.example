# Referência apenas. Configure os valores no painel do provedor, não no Git.
NODE_ENV=production
PORT=3001
API_HOST=0.0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST/DB_NAME?sslmode=verify-full
CORS_ORIGINS=https://frontend.example.com
# Única variável pública abaixo; incorporada no build do frontend.
VITE_API_BASE_URL=https://api.example.com
# Banco direto para migrations, se o provedor separar pooler e conexão direta.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST/DB_NAME?sslmode=verify-full

# Demo pública: usar banco vazio e exclusivo, vinculado por demo:prepare.
DEMO_MODE=true
DEMO_CLEANUP_ENABLED=true
DEMO_DATABASE_ID=REPLACE_WITH_DEDICATED_DEMO_UUID
DEMO_IP_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VITE_DEMO_MODE=true
# Manter 0 até validar a cadeia real do proxy; nunca usar confiança irrestrita.
TRUST_PROXY_HOPS=0
